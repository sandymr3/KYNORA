# ============================================
# KYNORA E-COMMERCE BACKEND CONFIGURATION
# ============================================

# ENVIRONMENT SETTINGS
ENVIRONMENT=development
DEBUG=True

# APPLICATION SETTINGS
APP_NAME="Kynora E-Commerce"
APP_VERSION="1.0.0"
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# SERVER SETTINGS
HOST=0.0.0.0
PORT=8000

# ============================================
# FIREBASE CONFIGURATION
# ============================================
FIREBASE_PROJECT_ID=kynora-ecommerce
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@kynora-ecommerce.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40kynora-ecommerce.iam.gserviceaccount.com

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# SECURITY & JWT
# ============================================
JWT_SECRET_KEY=your_super_secret_key_min_32_chars_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# DATABASE SETTINGS
# ============================================
FIRESTORE_COLLECTION_PREFIX=kynora_
# Production Firestore only - no emulator

# ============================================
# ADMIN SETTINGS
# ============================================
ADMIN_EMAIL=admin@kynora.com
ADMIN_PASSWORD=Admin@123456

# ============================================
# REDIS CACHE (Optional)
# ============================================
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# CORS SETTINGS
# ============================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_PAYMENTS=false
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true

# ============================================
# EMAIL CONFIGURATION (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@kynora.com
EMAIL_FROM_NAME=Kynora

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=kynora.log
